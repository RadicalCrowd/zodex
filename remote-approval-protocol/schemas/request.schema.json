{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zodex.local/schemas/remote-approval/request-v1.json",
  "title": "Zodex remote approval request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "request_id", "nonce", "issued_at", "expires_at", "active_device_epoch", "host", "action", "action_digest", "host_signature"],
  "properties": {
    "protocol_version": {"const": "zodex.remote-approval.v1"},
    "request_id": {"type": "string", "format": "uuid"},
    "nonce": {"type": "string", "pattern": "^[A-Za-z0-9_-]{22,}$", "maxLength": 86},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "active_device_epoch": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "host": {
      "type": "object", "additionalProperties": false,
      "required": ["host_id", "signing_key_id", "encryption_key_id"],
      "properties": {
        "host_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
        "signing_key_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
        "encryption_key_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"}
      }
    },
    "action": {"$ref": "#/$defs/action"},
    "action_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "host_signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"}
  },
  "$defs": {
    "safe_text": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[^\\u0000-\\u001F\\u007F]*$"},
    "path": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^/[^\\u0000-\\n\\r]*$"},
    "action": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind", "title", "summary", "executable", "argv", "cwd"], "properties": {"kind": {"const": "command"}, "title": {"$ref": "#/$defs/safe_text"}, "summary": {"$ref": "#/$defs/safe_text"}, "executable": {"$ref": "#/$defs/path"}, "argv": {"type": "array", "minItems": 0, "maxItems": 128, "items": {"$ref": "#/$defs/safe_text"}}, "cwd": {"$ref": "#/$defs/path"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "title", "summary", "operation", "paths"], "properties": {"kind": {"const": "file_change"}, "title": {"$ref": "#/$defs/safe_text"}, "summary": {"$ref": "#/$defs/safe_text"}, "operation": {"enum": ["create", "modify", "delete", "rename"]}, "paths": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/path"}}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "title", "summary", "permission", "scope"], "properties": {"kind": {"const": "permission"}, "title": {"$ref": "#/$defs/safe_text"}, "summary": {"$ref": "#/$defs/safe_text"}, "permission": {"$ref": "#/$defs/safe_text"}, "scope": {"$ref": "#/$defs/safe_text"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "title", "summary", "input"], "properties": {"kind": {"const": "user_input"}, "title": {"$ref": "#/$defs/safe_text"}, "summary": {"$ref": "#/$defs/safe_text"}, "input": {"$ref": "#/$defs/closed_input"}}}
      ]
    },
    "closed_input": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["type"], "properties": {"type": {"const": "boolean"}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "choices"], "properties": {"type": {"const": "enum"}, "choices": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["id", "label"], "properties": {"id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"}, "label": {"$ref": "#/$defs/safe_text"}}}}}}
      ]
    }
  }
}
